# Browser Secure Environment Configuration
#
# Copy this file to .env and fill in your credentials
# .env is gitignored - never commit secrets!

# =============================================================================
# BITWARDEN AUTHENTICATION
# =============================================================================
#
# IMPORTANT: For FULL automation, you need BOTH:
#   1. API key (for login) - BW_CLIENTID + BW_CLIENTSECRET
#   2. Master password (for vault unlock) - BW_PASSWORD
#
# OR use BW_SESSION (session token from manual unlock)

# --- API Key (for login) ---
# Create at: https://vault.bitwarden.com/#/settings/security/keys
# This handles authentication only, NOT vault decryption
# BW_CLIENTID=user.xxx-xxx
# BW_CLIENTSECRET=your-client-secret-here

# --- Master Password (for vault unlock) ---
# REQUIRED for automated vault access alongside API key
# Or use this alone instead of API key
# BW_PASSWORD=your-master-password

# --- Session Token (alternative to password) ---
# Set this instead of password if you've manually unlocked:
# BW_SESSION=your-session-token-from-bw-unlock-raw

# =============================================================================
# 1PASSWORD AUTHENTICATION (Alternative to Bitwarden)
# =============================================================================
# Create service account token: https://developer.1password.com/docs/service-accounts/
# OP_SERVICE_ACCOUNT_TOKEN=your-service-account-token

# =============================================================================
# SITE-SPECIFIC CREDENTIALS (Fallback when vault is unavailable)
# =============================================================================
# Format: BROWSER_SECURE_{SITENAME}_{FIELD}
# Example for neilpatel.com:
# BROWSER_SECURE_NEILPATEL_USERNAME=user@example.com
# BROWSER_SECURE_NEILPATEL_PASSWORD=your-password
# BROWSER_SECURE_NEILPATEL_TOKEN=your-api-token

# Example for nytimes.com:
# BROWSER_SECURE_NYTIMES_USERNAME=subscriber@example.com
# BROWSER_SECURE_NYTIMES_PASSWORD=your-password

# =============================================================================
# ADVANCED OPTIONS
# =============================================================================
# Custom config file path
# BROWSER_SECURE_CONFIG=~/.browser-secure/config.yaml

# Session timeout override (seconds)
# BROWSER_SECURE_TIMEOUT=1800
